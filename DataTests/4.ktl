typedef i8 -> stack_value

var const i32 MAX_STACK_SIZE = 10;

block stack_t {
    i32     head;
    i32     size;
    stack_value[10]  data;
}

var i32 size = 10 + 12;

var stack_t[4] stacks;

func bool stack_init(stack_t* stk,
                    i32 size)
{
    if (size <= 0 or size > MAX_STACK_SIZE) {
        return cast <bool> 0;
    }

    for (var i32 i = 0; i < MAX_STACK_SIZE; i = i + 1) {
        stk->data[i] = cast <stack_value> 0;
    }

    stk->head = 0;
    stk->size = size;

    return cast <bool> 0;
}

var i32 counter = 0;

func const i32 add(i32 a, i32 b) {
    return cast<i32> a;
}

main {
    var i32 x = 10;
    var const char* i;
    var stack_t s1;
    var stack_t s2;
    var stack_t s3;
    var stack_t s4;

    var stack_t[4] ss = {s1, s2, s3, s4};
    ss[1].head = 10;

    ss = stacks;

    if (x == 0) {
        var i32 y = 0;
    }
    else {
        var i32 y = 0;
    }

    /*
