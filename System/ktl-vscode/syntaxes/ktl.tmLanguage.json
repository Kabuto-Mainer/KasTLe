{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KasTLe",
  "scopeName": "source.ktl",
  "fileTypes": ["ktl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#use-statement" },
    { "include": "#function-decl" },
    { "include": "#typedef-decl" },
    { "include": "#block-decl" },
    { "include": "#cast-expr" },
    { "include": "#keywords-control" },
    { "include": "#keywords-decl" },
    { "include": "#keywords-operator" },
    { "include": "#types" },
    { "include": "#modifiers" },
    { "include": "#stdlib" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ktl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ktl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.ktl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ktl",
          "match": "\\\\(n|r|t|\\\\|\"|0|x[0-9A-Fa-f]{2})"
        },
        {
          "name": "constant.other.placeholder.ktl",
          "match": "%[-+ 0#]?[0-9]*\\.?[0-9]*[diouxXeEfgGcsp%]"
        }
      ]
    },

    "numbers": {
      "name": "constant.numeric.integer.ktl",
      "match": "\\b[0-9]+\\b"
    },

    "keywords-control": {
      "name": "keyword.control.ktl",
      "match": "\\b(if|elif|else|while|for|break|continue|return|exit|main|in|out)\\b"
    },

    "keywords-decl": {
      "name": "keyword.other.ktl",
      "match": "\\b(var|func|typedef|block|use|cast|include)\\b"
    },

    "keywords-operator": {
      "patterns": [
        {
          "name": "keyword.operator.logical.ktl",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "keyword.operator.comparison.ktl",
          "match": "\\b(equal|not_equal|less_or_equal|greater_or_equal|less|greater)\\b"
        }
      ]
    },

    "types": {
      "name": "storage.type.ktl",
      "match": "\\b(bool|void|i8|i16|i32|i64|char)\\b"
    },

    "modifiers": {
      "name": "storage.modifier.ktl",
      "match": "\\b(const|mutable|register|stack)\\b"
    },

    "stdlib": {
      "name": "support.function.builtin.ktl",
      "match": "\\b(print|scan|alloc|free|printf|scanf|calloc)\\b"
    },

    "use-statement": {
      "match": "\\b(use)\\s+(?:(const|mutable|register|stack)\\s+)*(?:(bool|void|i8|i16|i32|i64|char)\\s*\\*?\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.ktl" },
        "2": { "name": "storage.modifier.ktl" },
        "3": { "name": "storage.type.ktl" },
        "4": { "name": "entity.name.function.ktl" }
      }
    },

    "function-decl": {
      "match": "\\b(func)\\s+(?:(const|mutable|register|stack)\\s+)*(bool|void|i8|i16|i32|i64|char|[A-Za-z_][A-Za-z0-9_]*)\\s*\\*?\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.ktl" },
        "2": { "name": "storage.modifier.ktl" },
        "3": { "name": "storage.type.ktl" },
        "4": { "name": "entity.name.function.ktl" }
      }
    },

    "typedef-decl": {
      "match": "\\b(typedef)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\*?\\s*(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.ktl" },
        "2": { "name": "storage.type.ktl" },
        "3": { "name": "keyword.operator.typedef.ktl" },
        "4": { "name": "entity.name.type.ktl" }
      }
    },

    "block-decl": {
      "match": "\\b(block)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.ktl" },
        "2": { "name": "entity.name.type.ktl" }
      }
    },

    "cast-expr": {
      "begin": "\\b(cast)\\s*(<)",
      "beginCaptures": {
        "1": { "name": "keyword.other.ktl" },
        "2": { "name": "punctuation.definition.generic.begin.ktl" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.generic.end.ktl" }
      },
      "patterns": [
        { "include": "#types" },
        {
          "name": "entity.name.type.ktl",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "keyword.operator.pointer.ktl",
          "match": "\\*"
        }
      ]
    },

    "function-call": {
      "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.ktl" }
      }
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ktl",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.comparison.ktl",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.assignment.ktl",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ktl",
          "match": "\\+|\\-|\\*|/|%"
        },
        {
          "name": "keyword.operator.pointer.ktl",
          "match": "->|\\.|&"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.ktl", "match": "," },
        { "name": "punctuation.terminator.ktl", "match": ";" },
        { "name": "punctuation.section.brackets.ktl", "match": "\\(|\\)|\\[|\\]|\\{|\\}" }
      ]
    }
  }
}
