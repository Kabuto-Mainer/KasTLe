include "graphic.ktl"


main {
    var i64 WIDTH  = 64;
    var i64 HEIGHT = 64;

    gfx_init(cast<i32> WIDTH, cast<i32> HEIGHT, cast<i32> 10);

    // var i32 color_b = gfx_get_color(cast<i8> 0,   cast<i8> 0,   cast<i8> 0);
    // var i32 color_w = gfx_get_color(cast<i8> 255, cast<i8> 127, cast<i8> 255);

    var i32 color_w = gfx_get_color(cast<i8> 255,   cast<i8> 255,   cast<i8> 255);
    var i32 color_b = gfx_get_color_shadow(cast<i8> 32, cast<i8> 0,   cast<i8> 0,   cast<i8> 0);


    var i64 x = 0;
    var i64 y = 0;

    var i32 sc_up    = 82;
    var i32 sc_down  = 81;
    var i32 sc_left  = 80;
    var i32 sc_right = 79;


    while (1) {
        var i32 is_active = 1;
        if (gfx_poll_event() == 1) {
            break;
        }

        if (gfx_key_pressed(sc_up)) {
            y = y - 1;
            y = y % WIDTH;
        }
        elif (gfx_key_pressed(sc_down)) {
            y = y + 1;
            y = y % WIDTH;
        }
        elif (gfx_key_pressed(sc_left)) {
            x = x - 1;
            x = x % HEIGHT;
        }
        elif (gfx_key_pressed(sc_right)) {
            x = x + 1;
            x = x % HEIGHT;
        }
        else {
            is_active = 0;
        }

        gfx_rect(cast<i32> 0, cast<i32> 0, cast<i32> WIDTH, cast<i32> HEIGHT, color_b);
        // gfx_clear(color_b);
        if (is_active) {
            gfx_pixel(cast<i32> x, cast<i32> y, color_w);
            gfx_present();
        }
        gfx_delay(10);
        continue;
    }
    gfx_close();
    exit;
}
