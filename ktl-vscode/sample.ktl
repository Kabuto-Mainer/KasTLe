// KasTLe sample — used to eyeball the highlighting

/* block comment
   spans multiple lines */

typedef i8 -> stack_value;

block stack_t {
    i32 head;
    i32 size;
    stack_value data[10];
};

var const i32 MAX_STACK_SIZE = 10;
var stack i32 counter = 0;

func i32 push(stack_t* s, stack_value v) {
    if (s->size >= MAX_STACK_SIZE) {
        return -1;
    };
    s->data[s->head] = v;
    s->head = s->head + 1;
    s->size = s->size + 1;
    return 0;
};

func bool is_empty(stack_t* s) {
    return s->size equal 0;
};

main {
    var stack stack_t st;
    st.head = 0;
    st.size = 0;

    for (var i32 i = 0; i < 5; i = i + 1) {
        push(&st, cast<stack_value>(i * 2));
    };

    while (is_empty(&st) not_equal true and st.size > 0) {
        st.size = st.size - 1;
    };

    if (st.size equal 0) {
        exit;
    } elif (st.size less 5) {
        continue;
    } else {
        break;
    };
};
