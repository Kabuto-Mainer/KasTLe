#!/usr/bin/env bash
set -euo pipefail

COMPILER="./Bin/KasTle.elf"
EMIT="elf"
RUN_AFTER=0
DUMP_AST=0

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] <source>

Options:
  -e, --emit MODE   type of result file (default: elf)
                      elf    — own ELF generation
                      asm    — only .asm
                      nasm   — NASM + gcc generation
  -r, --run         run result elf file (for elf/nasm)
  -d, --dump-ast    dump AST to dump.html
  -h, --help        show help

Examples:
  ./ktl hello.ktl                # own ELF -> ./hello
  ./ktl -e asm hello.ktl         # .asm -> ./hello.asm
  ./ktl -e nasm -r hello.ktl     # NASM + gcc
EOF
}

SOURCE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -e|--emit)
            EMIT="$2"
            case "$EMIT" in
                asm|elf|nasm) ;;
                *) echo "error: unknown mode: $EMIT (asm|elf|nasm)" >&2; exit 1 ;;
            esac
            shift 2 ;;
        -r|--run)       RUN_AFTER=1; shift ;;
        -d|--dump-ast)  DUMP_AST=1;  shift ;;
        -h|--help)      usage; exit 0 ;;
        -*)             echo "unknown option: $1" >&2; usage; exit 1 ;;
        *)
            if [[ -n "$SOURCE" ]]; then
                echo "error: must be only one source" >&2; exit 1
            fi
            SOURCE="$1"; shift ;;
    esac
done

if [[ -z "$SOURCE" ]]; then
    echo "error: no source file" >&2
    usage; exit 1
fi
if [[ ! -f "$SOURCE" ]]; then
    echo "error: file is undefined: $SOURCE" >&2
    exit 1
fi

echo "==> Build KasTLe"
make -s

NAME="$(basename "${SOURCE%.*}")"
ASM="$NAME.asm"
OBJ="$NAME.o"
ELF="./$NAME"

COMPILE_ARGS=("$SOURCE")
[[ $DUMP_AST -eq 1 ]] && COMPILE_ARGS+=(--dump-ast dump.html)


case "$EMIT" in
    asm)
        echo "==> Compilation to ASM: $SOURCE -> $ASM"
        "$COMPILER" "${COMPILE_ARGS[@]}" --emit-asm -o "$ASM"
        echo "==> Ready: $ASM"
        ;;

    elf)
        echo "==> Compilation to own ELF: $SOURCE -> $ELF"
        "$COMPILER" "${COMPILE_ARGS[@]}" --emit-elf -o "$ELF"
        echo "==> Ready: $ELF"
        ;;

    nasm)
        echo "==> Compilation to ASM: $SOURCE -> $ASM"
        "$COMPILER" "${COMPILE_ARGS[@]}" --emit-asm -o "$ASM"

        echo "==> Assembly: nasm -> $OBJ"
        nasm -f elf64 -o "$OBJ" "$ASM"

        echo "==> Link: gcc -> $ELF"
        gcc -nostartfiles -no-pie -o "$ELF" "$OBJ"
        chmod +x "$ELF"

        echo "==> Ready: $ELF"
        ;;
esac

# =============================================================================
# Запуск
# =============================================================================
if [[ $RUN_AFTER -eq 1 ]]; then
    if [[ "$EMIT" == "asm" ]]; then
        echo "warning: --run doesn't work with --emit asm, skipped" >&2
        exit 0
    fi
    echo "==> run $ELF"
    echo "----------------------------------------"
    set +e
    "$ELF"
    rc=$?
    set -e
    echo "----------------------------------------"
    echo "exit code: $rc"
    exit $rc
fi
