#!/usr/bin/env bash
# ktl - запуск KasTle-компилятора на исходнике
set -euo pipefail

COMPILER="./Bin/KasTle.elf"
EMIT="elf"        # asm | elf | nasm
RUN_AFTER=0
DUMP_AST=0

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] <source>

Options:
  -e, --emit MODE   что генерировать (default: elf)
                      elf    — ELF собственным генератором
                      asm    — только .asm
                      nasm   — ELF через nasm + gcc
  -r, --run         запустить итоговый бинарь (для elf/nasm)
  -d, --dump-ast    сдампить AST в dump.html
  -h, --help        показать справку

Examples:
  ./ktl hello.ktl                # ELF своим генератором -> ./hello
  ./ktl -e asm hello.ktl         # .asm -> ./hello.asm
  ./ktl -e nasm -r hello.ktl     # ELF через nasm + запуск
EOF
}

# =============================================================================
# Аргументы
# =============================================================================
SOURCE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -e|--emit)
            EMIT="$2"
            case "$EMIT" in
                asm|elf|nasm) ;;
                *) echo "error: неизвестный режим: $EMIT (asm|elf|nasm)" >&2; exit 1 ;;
            esac
            shift 2 ;;
        -r|--run)       RUN_AFTER=1; shift ;;
        -d|--dump-ast)  DUMP_AST=1;  shift ;;
        -h|--help)      usage; exit 0 ;;
        -*)             echo "unknown option: $1" >&2; usage; exit 1 ;;
        *)
            if [[ -n "$SOURCE" ]]; then
                echo "error: несколько исходников" >&2; exit 1
            fi
            SOURCE="$1"; shift ;;
    esac
done

if [[ -z "$SOURCE" ]]; then
    echo "error: не указан исходный файл" >&2
    usage; exit 1
fi
if [[ ! -f "$SOURCE" ]]; then
    echo "error: файл не найден: $SOURCE" >&2
    exit 1
fi

# =============================================================================
# Сборка компилятора (make сам решит, что пересобирать)
# =============================================================================
echo "==> Build KasTLe"
make -s

# =============================================================================
# Имена выходных файлов
# =============================================================================
NAME="$(basename "${SOURCE%.*}")"
ASM="$NAME.asm"
OBJ="$NAME.o"
ELF="./$NAME"

# Общие аргументы для компилятора
COMPILE_ARGS=("$SOURCE")
[[ $DUMP_AST -eq 1 ]] && COMPILE_ARGS+=(--dump-ast dump.html)

# =============================================================================
# Сборка по режиму
# =============================================================================
case "$EMIT" in
    asm)
        echo "==> Compilation to ASM: $SOURCE -> $ASM"
        "$COMPILER" "${COMPILE_ARGS[@]}" --emit-asm -o "$ASM"
        echo "==> Ready: $ASM"
        ;;

    elf)
        echo "==> Compilation to own ELF: $SOURCE -> $ELF"
        "$COMPILER" "${COMPILE_ARGS[@]}" --emit-elf -o "$ELF"
        echo "==> Ready: $ELF"
        ;;

    nasm)
        echo "==> Compilation to ASM: $SOURCE -> $ASM"
        "$COMPILER" "${COMPILE_ARGS[@]}" --emit-asm -o "$ASM"

        echo "==> Assembly: nasm -> $OBJ"
        nasm -f elf64 -o "$OBJ" "$ASM"

        echo "==> Link: gcc -> $ELF"
        gcc -nostartfiles -no-pie -o "$ELF" "$OBJ"
        chmod +x "$ELF"

        echo "==> Ready: $ELF"
        ;;
esac

# =============================================================================
# Запуск
# =============================================================================
if [[ $RUN_AFTER -eq 1 ]]; then
    if [[ "$EMIT" == "asm" ]]; then
        echo "warning: --run doesn't work with --emit asm, skipped" >&2
        exit 0
    fi
    echo "==> run $ELF"
    echo "----------------------------------------"
    set +e
    "$ELF"
    rc=$?
    set -e
    echo "----------------------------------------"
    echo "exit code: $rc"
    exit $rc
fi
